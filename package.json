{
    "name": "mm-flextime-microsite",
    "version": "2.8.2",
    "description": "Motion Mechanics FlexTime™ Operations & Financial Model Interactive Microsite",
    "type": "module",
    "scripts": {
        "start": "python -m http.server 5500",
        "i18n:validate": "node scripts/validate-locales.cjs",
        "i18n:curate": "node scripts/curate-locales.cjs",
        "i18n:curate:apply": "node scripts/curate-locales.cjs --auto-promote --apply",
        "i18n:extract": "node scripts/extract-strings.cjs",
        "version": "npm run format:fix && node scripts/update-hashes.js && git add index.html",
        "postversion": "git push && git push --tags",
        "deploy": "node scripts/deploy.js",
        "publish": "npm version patch && npm run deploy",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test:e2e": "npx playwright test",
        "ci:e2e": "npm run i18n:validate && npx playwright test --project=chromium",
        "i18n:list-auto": "node scripts/list-auto-keys.cjs",
        "i18n:propose-curations": "node scripts/propose-curations.cjs",
        "i18n:prune-auto": "node scripts/prune-auto-duplicates.cjs"
    },
    "dependencies": {
        "dotenv": "^17.2.3"
    },
    "keywords": [
        "flextime",
        "motion-mechanics",
        "physiotherapy",
        "operations-model",
        "financial-model"
    ],
    "author": "Purrfect Software Limited",
    "license": "MIT",
    "packageManager": "yarn@4.11.0",
    "devDependencies": {
        "prettier": "^3.6.2",
        "@playwright/test": "^1.56.1"
    }
}
