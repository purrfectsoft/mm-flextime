{
    "name": "mm-flextime-microsite",
    "version": "3.0.0",
    "description": "Motion Mechanics FlexTime™ Operations & Financial Model Interactive Microsite",
    "type": "module",
    "scripts": {
        "start": "python -m http.server 5500",
        "version": "npm run format:fix && node scripts/update-hashes.js && git add index.html scripts/i18n.js",
        "postversion": "git push && git push --tags",
        "deploy": "node scripts/deploy.js",
        "publish": "npm version patch && npm run deploy",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test:e2e": "npx playwright test --config=playwright.config.js",
        "ci:e2e": "npx playwright test --config=playwright.config.js --project=chromium",
        "i18n:validate": "node scripts/validate-i18n.js"
    },
    "dependencies": {
        "dotenv": "^17.2.3"
    },
    "keywords": [
        "flextime",
        "motion-mechanics",
        "physiotherapy",
        "operations-model",
        "financial-model"
    ],
    "author": "Purrfect Software Limited",
    "license": "MIT",
    "packageManager": "yarn@4.11.0",
    "devDependencies": {
        "prettier": "^3.6.2",
        "@playwright/test": "^1.56.1"
    }
}
